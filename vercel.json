{
  "version": 2,
  "buildCommand": "cd client && npm install --include=dev && npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://c1-backend-6ay0.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://c1-backend-6ay0.onrender.com/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
